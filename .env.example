NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy client key, only needed for compatibility with older integrations.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key
# Server-only. Never expose this variable with NEXT_PUBLIC_ or client-side code.
SUPABASE_SECRET_KEY=your_server_secret_key

# Zalo Mini App server authentication. Keep the session secret server-only.
ZALO_MINI_APP_ID=your_zalo_mini_app_id
ZALO_MINIAPP_SESSION_SECRET=replace_with_at_least_32_random_characters

# Telegram notifications. Keep the bot token server-only.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Used only by `yarn admin:create`, never expose in the browser.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-long-random-password
ADMIN_NAME=Quản trị viên
ADMIN_USERNAME=admin
